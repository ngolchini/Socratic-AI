        {
          "id": "H1",
          "content": "What symptoms did the patient experience prior to admission?",
          "response": "Exertional dyspnea, fatigue, extensive ecchymoses and purpuric lesions, anorexia, persistent exertional dyspnea, frontal headache, apathy, irritability, increasing anorexia, nausea, unsteady gait, bruises on the left leg and abdomen, worsening dyspnea, lightheadedness, and increasing fatigue.",
          "teaching_points": [
            {
              "id": "TP1",
              "content": "Exertional dyspnea and fatigue in elderly patients can indicate cardiac or pulmonary issues, anemia, or systemic disease.",
              "covered": false
            }
          ],
          "elicited": false
        },
        {
          "id": "H2",
          "content": "What is the patient's past medical history?",
          "response": "Chronic alcoholism, severe hepatitis 20 years earlier, long history of hypertension treated with enalapril and verapamil.",
          "teaching_points": [
            {
              "id": "TP2",
              "content": "Chronic alcoholism can lead to liver disease, nutritional deficiencies, and cardiovascular issues.",
              "covered": false
            }
          ],
          "elicited": false
        },
        {
